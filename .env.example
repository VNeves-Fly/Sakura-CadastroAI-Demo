# Database (PostgreSQL via docker-compose)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cadtest?schema=public"

# NextAuth
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-strong-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# URL pública da aplicação — usada pra montar links em e-mails (reenvio de
# documentos, recuperação de senha). Sem essa variável, cai pro fallback
# "http://localhost:3000".
# APP_URL="http://localhost:3000"

# Google Cloud Storage — arquivos do cadastro (contrato social, RG, procuração).
# Sem essas variáveis, o backend cai pro disco local (uploads/) automaticamente.
GOOGLE_APPLICATION_CREDENTIALS="/path/para/service-account.json"
GCS_BUCKET_NAME="sakura-cadastro-documentos"
GCS_FOLDER_PREFIX="cadastro-ai"

# Agente de análise (agents.flysakura.com). Sem essa chave, cai pro mock
# (aprova por checksum do CNPJ) — ver flysakura-analise-ia.adapter.ts.
AGENCY_ANALYSIS_BASE_URL="https://agents.flysakura.com"
AGENCY_ANALYSIS_API_KEY="valor do header X-Internal-Secret"

# ReceitaWS — consulta de CNPJ/QSA (API Comercial, precisa de token pago).
# Sem essa variável, cai pro mock — ver receitaws-qsa-consulta.adapter.ts.
RECEITAWS_API_TOKEN="token da API Comercial"
RECEITAWS_MAX_DAYS="30"

# D4Sign — geração e envio de contrato pra assinatura. Sem essa variável,
# cai pro mock — ver d4sign.adapter.ts.
D4SIGN_TOKEN_API="token da API"
D4SIGN_CRYPT_KEY="crypt key da conta"
D4SIGN_SAFE_UUID="uuid do cofre onde os documentos entram"
D4SIGN_API_BASE_URL="https://secure.d4sign.com.br/api/v1" (produção) ou
  "https://sandbox.d4sign.com.br/api/v1" (sandbox, precisa de conta/token
  de sandbox separados — confirme que o token bate com a base escolhida)
D4SIGN_TEMPLATE_ID="id do template Word/HTML no D4Sign"
D4SIGN_WEBHOOK_URL="https://seu-dominio.com/api/webhooks/d4sign" (sem URL
  pública, o adapter pula o registro de webhook nesse documento)
D4SIGN_WEBHOOK_SECRET="secret key MAC gerada na área de API do D4Sign"

# SMTP — e-mails transacionais (boas-vindas, reenvio de documentos). Sem
# SMTP_HOST, cai pro mock (loga no console) — ver console-email.adapter.ts /
# console-welcome-email.adapter.ts. SMTP_USER precisa ser uma conta com
# relay SMTP habilitado; SMTP_PASSWORD é uma senha de app (não a senha
# normal da conta).
SMTP_HOST="smtp-relay.gmail.com"
SMTP_PORT="587"
SMTP_USER="nao-responder@seu-dominio.com.br"
SMTP_PASSWORD="senha de app, sem espaços"
EMAIL_FROM="Sakura Cadastro IA <nao-responder@seu-dominio.com.br>"

# Meta WhatsApp Business Cloud API — atendimento via WhatsApp. Sem
# WHATSAPP_ACCESS_TOKEN, cai pro mock — ver meta-whatsapp.adapter.ts.
WHATSAPP_ACCESS_TOKEN="token permanente do System User (Meta Business Suite)"
WHATSAPP_PHONE_NUMBER_ID="id do número de telefone Cloud API (não é o número em si)"
WHATSAPP_BUSINESS_ACCOUNT_ID="WABA ID — usado só pra listar/sincronizar templates"
WHATSAPP_WEBHOOK_VERIFY_TOKEN="valor arbitrário nosso, conferido no handshake GET"
WHATSAPP_APP_SECRET="App Secret do Meta App — valida X-Hub-Signature-256 no POST"
WHATSAPP_API_BASE_URL="https://graph.facebook.com/v21.0" (default)