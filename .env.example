# Database (PostgreSQL via docker-compose)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cadtest?schema=public"

# NextAuth
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-strong-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Google Cloud Storage — arquivos do cadastro (contrato social, RG, procuração).
# Sem essas variáveis, o backend cai pro disco local (uploads/) automaticamente.
# GOOGLE_APPLICATION_CREDENTIALS="/path/para/service-account.json"
# GCS_BUCKET_NAME="sakura-cadastro-documentos"
# GCS_FOLDER_PREFIX="cadastro-ai"
