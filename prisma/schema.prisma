generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Cargo {
  ADMIN
  DIRETOR_ANALISTA
  ANALISTA
  GESTOR
  EXECUTIVO
}

model User {
  id    String @id @default(cuid())
  // Nome completo, derivado de firstName+lastName na criação — mantido só
  // porque o módulo de auth (NextAuth session/JWT) já lê esta coluna direto;
  // firstName/lastName são a fonte estruturada usada pelo módulo users.
  name  String
  email String @unique

  firstName String @default("")
  lastName  String @default("")
  phone     String @default("")
  cargo     Cargo  @default(ANALISTA)

  // Força a troca de senha no próximo login (definida na criação do
  // usuário ou quando uma senha temporária é gerada).
  mustChangePassword Boolean @default(false)

  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mensagensEnviadas       Mensagem[]
  atendimentosAssumidos   AssumirAtendimentoRegistro[]
  textosProntosCriados    TextoPronto[]
  transferenciasFeitas    SolicitacaoTransferencia[]   @relation("TransferenciaFeitaPor")
  transferenciasRecebidas SolicitacaoTransferencia[]   @relation("TransferenciaParaAnalista")
  passwordResetTokens     PasswordResetToken[]

  @@map("users")
}

enum PasswordResetStatus {
  PENDING
  VERIFIED
  USED
}

// Recuperação de senha por OTP (6 dígitos) + token de link, ambos enviados
// por e-mail e nunca persistidos em texto puro (só sha256 em tokenHash/
// codigoHash — ver password-reset-hash.util.ts). A proteção real vem de
// expiraEm + tentativas + status USED (uso único), não do custo do hash.
model PasswordResetToken {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash  String @unique
  codigoHash String

  status       PasswordResetStatus @default(PENDING)
  tentativas   Int                 @default(0)
  verificadoEm DateTime?
  usadoEm      DateTime?
  expiraEm     DateTime

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

// ---------------------------------------------------------------------------
// Domínio de cadastro de agências. Fusão do schema normalizado descrito em
// prisma/schema.md e etapas/nullable.md (sem colunas JSON, uma tabela por
// conceito) com o que já está implementado e rodando em cima de `Agencia`:
// campos básicos obrigatórios (o wizard público já coleta tudo antes do
// submit), `contratoSocialPath` como coluna direta, `provedorId` genérico
// de provedor de assinatura, e `origemGeracao` por contrato.
//
// Tabelas/colunas do schema antigo que a UI atual ainda não popula (CADASTUR,
// vendas percentuais, gate de IA, kanban, decisões humanas, avanços forçados,
// notificações) continuam existindo, nullable, prontas pro roadmap de
// etapas/README.md sem quebrar o fluxo de hoje. `signatarios_padrao` já é
// populada (ver prisma/seed.ts) mas ainda não é lida pelo fluxo de contrato.
// ---------------------------------------------------------------------------

enum StatusAgencia {
  em_analise
  em_complementar
  aguardando_assinatura
  aguardando_validacao
  aguardando_ativacao
  ativo
  recusado
}

enum StatusContrato {
  aguardando_assinatura
  // Aprovador (papel APROVAR, estágio 1) assinou — sócios (estágio 0) já
  // tinham assinado antes dele. Falta só os signatários fixos restantes
  // (estágio 2, testemunhas) pra fechar; não bloqueia o avanço da agência.
  assinado_agencia
  assinado
}

enum OrigemGeracaoContrato {
  ia
  humano
}

enum TipoDocumento {
  CONTRATO_SOCIAL
  CADASTUR
  RG_CNPJ
  COMPROVANTE_ENDERECO
  COMPROVANTE_ENDERECO_AGENCIA
  CERTIDAO_CASAMENTO
  PROCURACAO
}

enum StatusDocumento {
  PENDENTE
  APROVADO
  REPROVADO
}

enum PapelRepresentante {
  SOCIO
  PROCURADOR
}

enum TipoVenda {
  NACIONAL
  INTERNACIONAL
  TERRESTRE
}

enum EtapaDecisao {
  ANALISE
  COMPLEMENTAR
}

enum ResultadoDecisao {
  APROVADO
  REPROVADO
}

model Agencia {
  id                 String        @id @default(cuid())
  razaoSocial        String
  cnpj               String        @unique
  etapaAtual         Int           @default(1)
  status             StatusAgencia @default(em_analise)
  contratoSocialPath String
  emailContato       String
  telefoneContato    String
  origem             String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  // Confirmados manualmente pelo analista na etapa de Validação, antes de
  // liberar a Ativação — com log de quem confirmou e quando (mesmo padrão
  // de leituraConfirmadaPor/Em em Contrato).
  sicaCodigo         String?
  sicaSalvoPor       String?
  sicaSalvoEm        DateTime?
  travelLinkCriado   Boolean   @default(false)
  travelLinkSalvoPor String?
  travelLinkSalvoEm  DateTime?

  complementar         CadastroComplementar?
  representantesLegais RepresentanteLegal[]
  documentos           Documento[]
  contratos            Contrato[]
  analiseIa            AnaliseIaAgencia?
  dadosReceita         DadosReceita?
  gateValidacoes       GateValidacao[]
  alertas              Alerta[]
  usuarioMaster        UsuarioMaster?
  avancosForcados      AvancoForcado[]
  kanbanHistorico      KanbanHistorico[]
  decisoesHumanas      DecisaoHumana[]
  notificacoes         Notificacao[]
  conversas            Conversa[]

  @@map("agencias")
}

// Cache normalizado da consulta à Receita Federal (CNPJ) — roadmap
// (etapas/README.md), não populado pelo fluxo atual.
model DadosReceita {
  id        String  @id @default(cuid())
  agenciaId String  @unique
  agencia   Agencia @relation(fields: [agenciaId], references: [id], onDelete: Cascade)

  situacaoCadastral String?
  dataAbertura      DateTime?
  naturezaJuridica  String?
  porte             String?
  capitalSocial     Decimal?  @db.Decimal(14, 2)
  telefone          String?
  email             String?
  optanteSimples    Boolean   @default(false)
  dataOpcaoSimples  DateTime?

  endereco Endereco?

  consultadoEm DateTime @default(now())

  cnaes Cnae[]

  @@map("dados_receita")
}

model Cnae {
  id             String       @id @default(cuid())
  dadosReceitaId String
  dadosReceita   DadosReceita @relation(fields: [dadosReceitaId], references: [id], onDelete: Cascade)
  codigo         String?
  descricao      String?
  principal      Boolean      @default(false)

  @@index([dadosReceitaId])
  @@map("cnaes")
}

// Resultado do gate automático de IA — roadmap, não populado hoje (a
// decisão da IA no fluxo atual mora só no `origemGeracao`/status do
// Contrato).
model GateValidacao {
  id             String   @id @default(cuid())
  agenciaId      String
  agencia        Agencia  @relation(fields: [agenciaId], references: [id], onDelete: Cascade)
  etapaAlvo      Int?
  liberado       Boolean?
  motivoBloqueio String?
  avaliadoEm     DateTime @default(now())

  @@index([agenciaId])
  @@map("gate_validacoes")
}

model Alerta {
  id          String    @id @default(cuid())
  agenciaId   String
  agencia     Agencia   @relation(fields: [agenciaId], references: [id], onDelete: Cascade)
  tipo        String?
  mensagem    String?
  criadoEm    DateTime  @default(now())
  resolvidoEm DateTime?

  @@index([agenciaId])
  @@map("alertas")
}

// Credencial de acesso da Etapa 4 (Usuário Master) — salvo de verdade
// pelo analista no dossiê (SalvarUsuarioMasterUseCase). `ativo` marca que
// existe um registro salvo (equivalente ao `salvo !== null` que a tela já
// calculava só localmente antes). `origemRepresentanteLegalId` é só
// referência de exibição (qual sócio, se houver, os dados vieram) — sem
// FK formal, não trava se o sócio for removido depois.
model UsuarioMaster {
  id                         String    @id @default(cuid())
  agenciaId                  String    @unique
  agencia                    Agencia   @relation(fields: [agenciaId], references: [id], onDelete: Cascade)
  nome                       String?
  email                      String?
  cpf                        String?
  telefone                   String?
  rg                         String?
  rgOrgaoEmissor             String?
  rgUf                       String?
  dataNascimento             DateTime?
  origemRepresentanteLegalId String?
  ativo                      Boolean   @default(false)
  salvoPor                   String?
  salvoEm                    DateTime?
  criadoEm                   DateTime  @default(now())

  @@map("usuarios_master")
}

// Compartilhado por três donos mutuamente exclusivos. O FK fica do lado
// do Endereco (nunca do lado do dono) pra que apagar o dono cascateie até
// aqui — ver prisma/schema.md pra o raciocínio completo.
model Endereco {
  id          String  @id @default(cuid())
  cep         String?
  logradouro  String?
  numero      String?
  complemento String?
  bairro      String?
  cidade      String?
  uf          String?

  dadosReceitaId String?       @unique
  dadosReceita   DadosReceita? @relation(fields: [dadosReceitaId], references: [id], onDelete: Cascade)

  cadastroComplementarId String?               @unique
  cadastroComplementar   CadastroComplementar? @relation(fields: [cadastroComplementarId], references: [id], onDelete: Cascade)

  representanteLegalId String?             @unique
  representanteLegal   RepresentanteLegal? @relation(fields: [representanteLegalId], references: [id], onDelete: Cascade)

  @@map("enderecos")
}

model CadastroComplementar {
  id        String  @id @default(cuid())
  agenciaId String  @unique
  agencia   Agencia @relation(fields: [agenciaId], references: [id], onDelete: Cascade)

  // Passo 2 — Empresa
  telefoneComercial String?
  emailOperacional  String?
  emailComercial    String?
  emailFinanceiro   String?

  // CADASTUR — roadmap, não coletado pela UI atual
  cadasturNumero       String?
  cadasturDataCadastro DateTime?
  cadasturValidade     DateTime?
  cadasturSituacao     String?

  // Passo 3 — Comercial — roadmap. `clienteInternacional` nunca é
  // persistido: é sempre o inverso de `resideBrasil`, derivado na
  // aplicação.
  resideBrasil Boolean?

  // Passo 6 — Endereço da agência & Banco
  tipoAgencia                 String?
  enderecoAgencia             Endereco?
  enderecoAgenciaMesmoTitular Boolean?
  socioVinculadoEnderecoId    String?
  socioVinculadoEndereco      RepresentanteLegal? @relation("SocioVinculadoEndereco", fields: [socioVinculadoEnderecoId], references: [id])

  bancoPais           String?
  bancoNome           String?
  bancoCodigo         String?
  bancoAgencia        String?
  bancoConta          String?
  bancoSwift          String?
  tipoConta           String?
  favorecidoEhEmpresa Boolean?
  favorecidoNome      String?
  favorecidoDoc       String?

  // Roadmap (schema antigo), não usado pela UI atual
  chavePix         String?
  tipoChavePix     String?
  tipoFaturamento  String?
  percCorporativo  Decimal? @db.Decimal(5, 2)
  percConvencional Decimal? @db.Decimal(5, 2)

  submetidoAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vendasPercentuais VendaPercentual[]

  @@map("cadastros_complementares")
}

// Roadmap — substitui os JSONs paralelos de vendas por tipo/percentual;
// não populado pela UI atual.
model VendaPercentual {
  id                     String               @id @default(cuid())
  cadastroComplementarId String
  cadastroComplementar   CadastroComplementar @relation(fields: [cadastroComplementarId], references: [id], onDelete: Cascade)
  tipo                   TipoVenda?
  percentual             Decimal?             @db.Decimal(5, 2)

  @@unique([cadastroComplementarId, tipo])
  @@map("venda_percentuais")
}

model RepresentanteLegal {
  id        String  @id @default(cuid())
  agenciaId String
  agencia   Agencia @relation(fields: [agenciaId], references: [id], onDelete: Cascade)

  nome                 String
  email                String
  telefone             String
  cpf                  String
  cnpj                 String?
  isPj                 Boolean            @default(false)
  rg                   String?
  rgOrgaoEmissor       String?
  dataNascimento       DateTime?
  estadoCivil          String
  regimeBens           String?
  nacionalidade        String?
  cargo                String?
  papel                PapelRepresentante @default(SOCIO)
  // Sócio marcado como representante legal da empresa (libera o slot de
  // Procuração no wizard) — distinto de `papel`, que é pra um procurador
  // terceiro fora do quadro societário (roadmap, não usado hoje).
  isRepresentanteLegal Boolean            @default(false)
  ativo                Boolean            @default(true)
  origem               String?
  preenchidoPorIa      Boolean            @default(false)

  endereco Endereco?
  conjuge  Conjuge?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documentos                Documento[]
  contratoSignatarios       ContratoSignatario[]
  enderecosAgenciaVinculada CadastroComplementar[] @relation("SocioVinculadoEndereco")
  conversas                 Conversa[]

  @@unique([agenciaId, cpf])
  @@map("representantes_legais")
}

// Roadmap (Passo 5, PF casado) — não coletado pela UI atual.
model Conjuge {
  id                   String             @id @default(cuid())
  representanteLegalId String             @unique
  representanteLegal   RepresentanteLegal @relation(fields: [representanteLegalId], references: [id], onDelete: Cascade)
  nome                 String?
  cpf                  String?
  rg                   String?
  nacionalidade        String?

  @@map("conjuges")
}

model Documento {
  id        String  @id @default(cuid())
  agenciaId String
  agencia   Agencia @relation(fields: [agenciaId], references: [id], onDelete: Cascade)

  representanteLegalId String?
  representanteLegal   RepresentanteLegal? @relation(fields: [representanteLegalId], references: [id])

  tipo     TipoDocumento
  fileName String?
  mimeType String?

  // Caminho retornado pelo FileStorage (local hoje, GCS futuramente).
  // Bucket/tamanho/hash ficam nullable porque o LocalFileStorage atual
  // não produz esses metadados.
  gcsPath   String
  gcsBucket String?
  gcsSize   Int?
  gcsMd5    String?

  status           StatusDocumento @default(PENDENTE)
  verificado       Boolean         @default(false)
  reprovadoPor     String?
  motivoReprovacao String?
  reprovadoEm      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  analiseIa AnaliseIaDocumento?

  @@index([agenciaId])
  @@map("documentos")
}

// Espelha DocumentAnalysisResultado (o retorno do FlysakuraDocumentAnalysisAdapter)
// pra qualquer document_type (contrato_social, cnh_rg, ...) — não um schema fixo
// tipo CADASTUR, já que o agente decide as chaves de `campos`/`camposExtras`
// dinamicamente por tipo de documento/sociedade. Roadmap: ainda não populado
// (FinalizarCadastroUseCase descarta o retorno de documentAnalysisService.analisar()).
model AnaliseIaDocumento {
  id          String    @id @default(cuid())
  documentoId String    @unique
  documento   Documento @relation(fields: [documentoId], references: [id], onDelete: Cascade)

  camposExtraidos             Json
  camposExtras                Json
  confiancaExtracao           Decimal  @db.Decimal(5, 2)
  alertas                     String[]
  resumoAnalise               String?
  textoBruto                  String?
  formatoValido               Boolean?
  camposObrigatoriosPresentes Boolean?
  referenciaCruzadaOk         Boolean?
  detalhesChecagem            Json?

  processadoEm DateTime @default(now())

  @@map("analises_ia_documentos")
}

// Classificação de por que a agência chegou no status atual — distingue
// um REPROVADO de verdade (a IA avaliou e disse não) de uma falha técnica
// que nunca chegou a produzir um parecer real (FALHA_ANALISE) ou de uma
// aprovação cujo contrato não pôde ser gerado/enviado (FALHA_CONTRATO).
// EM_ANALISE é o valor inicial, gravado já na persistência do cadastro
// (junto da Agencia, status "em_analise") — a linha nunca fica ausente
// pra um cadastro que já foi persistido; registrarAnaliseFinal só
// atualiza pra um dos outros três quando a IA termina.
// Adicionado em 2026-07-24 junto do fluxo assíncrono de análise (ver
// AnalisarCadastroUseCase) — antes disso só existia o texto livre em
// `motivo`, sem como diferenciar programaticamente os três casos.
enum ResultadoAnaliseIa {
  EM_ANALISE
  APROVADO
  REPROVADO
  FALHA_ANALISE
  FALHA_CONTRATO
}

// Veredito (ou estado atual) do /agency-analysis/sync
// (parecer/justificativa/flags_risco + stage3, o cruzamento
// documento×fonte oficial×fornecido) — uma linha por agência, criada já
// na persistência do cadastro (resultado=EM_ANALISE) e atualizada quando
// a IA termina. Existe pra dar contexto real ao analista quando o
// parecer não é APROVADO, em vez de só o status "em_complementar" sem
// explicação.
model AnaliseIaAgencia {
  id        String             @id @default(cuid())
  agenciaId String             @unique
  agencia   Agencia            @relation(fields: [agenciaId], references: [id], onDelete: Cascade)

  resultado    ResultadoAnaliseIa
  parecer      String?
  motivo       String?
  flagsRisco   String[]
  detalhamento Json?

  avaliadoEm DateTime @default(now())

  @@map("analises_ia_agencias")
}

model Contrato {
  id            String                @id @default(cuid())
  agenciaId     String
  agencia       Agencia               @relation(fields: [agenciaId], references: [id], onDelete: Cascade)
  provedorId    String
  status        StatusContrato        @default(aguardando_assinatura)
  origemGeracao OrigemGeracaoContrato

  numContrato        String? @unique
  conteudoPreenchido String? @db.Text

  leituraConfirmada    Boolean   @default(false)
  leituraConfirmadaPor String?
  leituraConfirmadaEm  DateTime?

  contratoGcsPath    String?
  pdfAssinadoGcsPath String?
  assinadoAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  signatarios        ContratoSignatario[]
  emailsFalhaEntrega ContratoEmailFalhaEntrega[]

  @@index([agenciaId])
  @@map("contratos")
}

// Registro de "e-mail não entregue" (D4Sign webhook, type_post=2) — por
// e-mail, não por ContratoSignatario/SignatarioPadrao: cobre tanto os
// sócios quanto os 4 signatários fixos da Sakura sem depender de CPF (que
// os fixos não têm). @@unique pra upsert idempotente em retries do
// D4Sign — o motivo/data mais recentes sobrescrevem o registro anterior.
model ContratoEmailFalhaEntrega {
  id         String   @id @default(cuid())
  contratoId String
  contrato   Contrato @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  email      String
  motivo     String?
  criadoEm   DateTime @default(now())

  @@unique([contratoId, email])
  @@map("contrato_email_falha_entrega")
}

// Snapshot imutável do signatário no momento em que o contrato foi
// gerado — se o sócio corrigir o endereço em RepresentanteLegal depois,
// o contrato já emitido não muda retroativamente.
model ContratoSignatario {
  id         String   @id @default(cuid())
  contratoId String
  contrato   Contrato @relation(fields: [contratoId], references: [id], onDelete: Cascade)

  representanteLegalId String?
  representanteLegal   RepresentanteLegal? @relation(fields: [representanteLegalId], references: [id])
  signatarioPadraoId   String?
  signatarioPadrao     SignatarioPadrao?   @relation(fields: [signatarioPadraoId], references: [id])

  nome           String
  email          String
  cpf            String
  rg             String?
  rgOrgaoEmissor String?
  cargo          String?
  nacionalidade  String?
  estadoCivil    String?
  dataNascimento DateTime?

  cepSnapshot         String?
  logradouroSnapshot  String?
  numeroSnapshot      String?
  complementoSnapshot String?
  bairroSnapshot      String?
  cidadeSnapshot      String?
  ufSnapshot          String?

  camposPendentes ContratoCampoPendente[]

  @@index([contratoId])
  @@map("contrato_signatarios")
}

// Roadmap — pendências ignoradas quando o contrato é gerado com
// "force: true"; não usado pela UI atual.
model ContratoCampoPendente {
  id                   String             @id @default(cuid())
  contratoSignatarioId String
  contratoSignatario   ContratoSignatario @relation(fields: [contratoSignatarioId], references: [id], onDelete: Cascade)
  campo                String?

  @@map("contrato_campos_pendentes")
}

// Roadmap — histórico de overrides manuais de etapa; não usado hoje.
model AvancoForcado {
  id                 String   @id @default(cuid())
  agenciaId          String
  agencia            Agencia  @relation(fields: [agenciaId], references: [id], onDelete: Cascade)
  etapaAlvo          Int?
  motivo             String?
  gateMotivoBloqueio String?
  statusReal         String?
  solicitadoPor      String?
  autorizadoPor      String?
  createdAt          DateTime @default(now())

  pendencias AvancoForcadoPendencia[]

  @@index([agenciaId])
  @@map("avancos_forcados")
}

model AvancoForcadoPendencia {
  id              String        @id @default(cuid())
  avancoForcadoId String
  avancoForcado   AvancoForcado @relation(fields: [avancoForcadoId], references: [id], onDelete: Cascade)
  descricao       String?

  @@map("avanco_forcado_pendencias")
}

// Roadmap — log de auditoria de transição de etapa; não usado hoje (o
// admin já grava status diretamente em Agencia.status).
model KanbanHistorico {
  id                String   @id @default(cuid())
  agenciaId         String
  agencia           Agencia  @relation(fields: [agenciaId], references: [id], onDelete: Cascade)
  etapaAnterior     Int?
  etapaNova         Int?
  usuarioEmail      String?
  origem            String?
  observacao        String?
  desbloqueioManual Boolean?
  detalhes          String?  @db.Text
  createdAt         DateTime @default(now())

  @@index([agenciaId])
  @@map("kanban_historico")
}

// Roadmap — decisão manual de aprovação/reprovação em qualquer etapa com
// gate humano; não usado hoje (aprovação manual mora em
// AprovarCadastroComplementarUseCase, sem log próprio ainda).
model DecisaoHumana {
  id            String            @id @default(cuid())
  agenciaId     String
  agencia       Agencia           @relation(fields: [agenciaId], references: [id], onDelete: Cascade)
  etapa         EtapaDecisao?
  decisaoIa     String?
  decisaoHumana ResultadoDecisao?
  justificativa String?           @db.Text
  usuarioEmail  String?
  modeloIa      String?
  scoreIa       Float?
  divergiu      Boolean?
  createdAt     DateTime          @default(now())

  @@index([agenciaId])
  @@map("decisoes_humanas")
}

// Roadmap — não usado hoje.
model Notificacao {
  id        String   @id @default(cuid())
  agenciaId String
  agencia   Agencia  @relation(fields: [agenciaId], references: [id], onDelete: Cascade)
  tipo      String?
  titulo    String?
  mensagem  String?
  createdAt DateTime @default(now())

  @@index([agenciaId])
  @@map("notificacoes")
}

// Signatários fixos da Sakura (mesmos em todo contrato). `papel` é o ato no
// D4Sign (catálogo completo do campo `act` da API, não só os usados hoje) e
// `estagio` é o after_position da fila de assinatura — estágio 0 é sempre os
// sócios da agência (dinâmico, fora desta tabela); os fixos ocupam os
// estágios seguintes. `deletedAt` é o padrão de soft delete pra essa tabela
// (e daqui pra frente, pro projeto): null = ativo, preenchido = removido
// (reversível — `findAtivos` filtra por `deletedAt: null`).
model SignatarioPadrao {
  id        String                @id @default(cuid())
  nome      String?
  cargo     String?
  email     String?               @unique
  telefone  String?
  deletedAt DateTime?
  ordem     Int?
  papel     PapelSignatarioPadrao
  estagio   Int

  contratoSignatarios ContratoSignatario[]

  @@map("signatarios_padrao")
}

// Espelha 1:1 o campo `act` da API do D4Sign (https://docapi.d4sign.com.br/,
// tabela de "Ações permitidas") — cada valor é o ato do signatário no
// documento. Hoje só APROVAR, ASSINAR_COMO_PARTE e ASSINAR_COMO_TESTEMUNHA
// são usados pelos 4 signatários fixos da Sakura; o resto existe pra manter
// o enum fiel ao catálogo real da API, sem precisar de nova migration se um
// papel diferente entrar em uso.
enum PapelSignatarioPadrao {
  ASSINAR // act=1
  APROVAR // act=2
  RECONHECER // act=3
  ASSINAR_COMO_PARTE // act=4
  ASSINAR_COMO_TESTEMUNHA // act=5
  ASSINAR_COMO_INTERVENIENTE // act=6
  ACUSAR_RECEBIMENTO // act=7
  ASSINAR_COMO_EMISSOR_ENDOSSANTE_AVALISTA // act=8
  ASSINAR_COMO_EMISSOR_ENDOSSANTE_AVALISTA_FIADOR // act=9
  ASSINAR_COMO_FIADOR // act=10
  ASSINAR_COMO_PARTE_E_FIADOR // act=11
  ASSINAR_COMO_RESPONSAVEL_SOLIDARIO // act=12
  ASSINAR_COMO_PARTE_E_RESPONSAVEL_SOLIDARIO // act=13
}

// ---------------------------------------------------------------------------
// Domínio de Atendimento (WhatsApp / Meta Cloud API) — conversas entre
// analistas e contatos das agências (sócios/representantes/comercial), com
// histórico de mensagens (texto/áudio/imagem/pdf) e de "assumir
// atendimento". Espelha o contrato de tipos consumido pelo front em
// src/modules/atendimento/types/atendimento.types.ts.
// ---------------------------------------------------------------------------

enum TipoContatoConversa {
  AGENCIA
  NAO_IDENTIFICADO
}

enum PapelMembroConversa {
  SOCIO
  REPRESENTANTE_LEGAL
  COMERCIAL
  OUTRO
}

enum TipoMensagemWhatsApp {
  TEXTO
  AUDIO
  IMAGEM
  PDF
}

enum AutorMensagem {
  CLIENTE
  ANALISTA
}

enum StatusEntregaMensagem {
  ENVIADO
  ENTREGUE
  LIDO
  FALHOU
}

enum StatusTemplateWhatsApp {
  APPROVED
  PENDING
  REJECTED
  PAUSED
}

// Uma linha por número de telefone WhatsApp (wa_id) com histórico de troca
// de mensagens. agenciaId nullable + tipoContato cobrem o caso "não
// identificado" (decisão de produto 2026-07-23): quando o número inbound
// não bate com RepresentanteLegal.telefone / Agencia.telefoneContato /
// CadastroComplementar.telefoneComercial, a conversa é criada mesmo assim
// (nunca descartada), com agenciaId = null e tipoContato =
// NAO_IDENTIFICADO, pra aparecer na aba "não identificado" do front.
model Conversa {
  id          String              @id @default(cuid())
  tipoContato TipoContatoConversa @default(AGENCIA)

  agenciaId String?
  agencia   Agencia? @relation(fields: [agenciaId], references: [id], onDelete: Cascade)

  telefoneWhatsapp String @unique // wa_id — E.164 dígitos, sem "+"

  // Snapshot de exibição (nome/papel) do momento do match de contato — não
  // é FK formal pro membro porque contatos "não identificados" não têm
  // representante nenhum vinculado.
  membroNome     String?
  membroPapel    PapelMembroConversa @default(OUTRO)
  membroTelefone String

  representanteLegalId String?
  representanteLegal   RepresentanteLegal? @relation(fields: [representanteLegalId], references: [id])

  mensagens                 Mensagem[]
  atendimentos              AssumirAtendimentoRegistro[]
  solicitacoesTransferencia SolicitacaoTransferencia[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastMessageAt DateTime?

  @@index([agenciaId])
  @@index([tipoContato])
  @@map("conversas")
}

enum StatusSolicitacaoTransferencia {
  PENDENTE
  ACEITA
  RECUSADA
  EXPIRADA
}

// Transferência de atendimento entre analistas — pedido explícito (não
// depende da regra de 2h de HORAS_LIMITE_ASSUMIR, que é só pra "puxar" de
// quem sumiu). Expira sozinha depois de TIMEOUT_TRANSFERENCIA_MS sem
// resposta (contada como recusa) — a transição pra EXPIRADA é feita de
// forma preguiçosa na leitura (ver PrismaConversaRepository), não por job
// em background. `limpaEm` marca que o solicitante já viu o resultado
// (recusada/expirada) e dispensou o aviso — depois disso a conversa
// aparece sem solicitacaoTransferenciaPendente, liberando um novo pedido.
model SolicitacaoTransferencia {
  id         String   @id @default(cuid())
  conversaId String
  conversa   Conversa @relation(fields: [conversaId], references: [id], onDelete: Cascade)

  deAnalistaId String
  deAnalista   User   @relation("TransferenciaFeitaPor", fields: [deAnalistaId], references: [id])

  paraAnalistaId String
  paraAnalista   User   @relation("TransferenciaParaAnalista", fields: [paraAnalistaId], references: [id])

  status   StatusSolicitacaoTransferencia @default(PENDENTE)
  criadaEm DateTime                       @default(now())

  resolvidaEm DateTime?
  limpaEm     DateTime?

  @@index([conversaId])
  @@map("solicitacoes_transferencia")
}

model Mensagem {
  id         String   @id @default(cuid())
  conversaId String
  conversa   Conversa @relation(fields: [conversaId], references: [id], onDelete: Cascade)

  autor      AutorMensagem
  analistaId String?
  // Analista que enviou — FK real pro User (nunca string livre vinda do
  // cliente); nullable porque mensagens do cliente (autor = CLIENTE) não
  // têm analista.
  analista   User?         @relation(fields: [analistaId], references: [id])

  tipo                TipoMensagemWhatsApp
  conteudo            String               @db.Text // texto puro, ou caption/nome de arquivo p/ mídia
  duracaoSegundos     Int? // só tipo = AUDIO
  tamanhoArquivoBytes Int? // só tipo != TEXTO — front formata pra exibição

  midiaId String?        @unique
  midia   MensagemMidia? @relation(fields: [midiaId], references: [id])

  lido   Boolean               @default(false)
  status StatusEntregaMensagem @default(ENVIADO)

  // Id da mensagem no WhatsApp Cloud API — outbound (msg que nós mandamos)
  // ou inbound (msg do cliente) — chave de idempotência do webhook (Meta
  // redelivera eventos em retry).
  waMessageId String? @unique

  createdAt DateTime @default(now())

  @@index([conversaId])
  @@index([conversaId, createdAt])
  @@map("mensagens")
}

// Metadados do arquivo de mídia baixado do WhatsApp e salvo via
// FileStorage (mesmo padrão de Documento: gcsPath/gcsBucket/gcsSize/
// gcsMd5). Tabela própria (não colunas soltas em Mensagem) pra manter
// Mensagem enxuta.
model MensagemMidia {
  id       String    @id @default(cuid())
  mensagem Mensagem?

  fileName String?
  mimeType String?

  gcsPath   String
  gcsBucket String?
  gcsSize   Int?
  gcsMd5    String?

  createdAt DateTime @default(now())

  @@map("mensagens_midia")
}

// Histórico de "assumir atendimento" — cada linha é um período em que um
// analista específico esteve responsável pela conversa. liberadoEm null =
// é o registro atual (no máximo um por conversa, garantido pela use-case).
model AssumirAtendimentoRegistro {
  id         String   @id @default(cuid())
  conversaId String
  conversa   Conversa @relation(fields: [conversaId], references: [id], onDelete: Cascade)

  analistaId String
  analista   User   @relation(fields: [analistaId], references: [id])

  assumidoEm DateTime  @default(now())
  liberadoEm DateTime?

  @@index([conversaId])
  @@map("assumir_atendimento_registros")
}

// Textos prontos (respostas rápidas) — globais, CRUD simples.
model TextoPronto {
  id          String   @id @default(cuid())
  titulo      String
  conteudo    String   @db.Text
  criadoPorId String?
  criadoPor   User?    @relation(fields: [criadoPorId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("textos_prontos")
}

// Cache local dos templates aprovados na Meta (Business Management API
// "message_templates"). Preferido a config-only (exigiria deploy pra cada
// template novo aprovado) ou fetch ao vivo a cada listagem (acopla a
// listagem à latência/disponibilidade da Graph API) — populado por
// SincronizarTemplatesWhatsAppUseCase via upsert por metaTemplateId.
model TemplateWhatsApp {
  id             String                 @id @default(cuid())
  metaTemplateId String                 @unique
  nome           String
  idioma         String                 @default("pt_BR")
  categoria      String?
  status         StatusTemplateWhatsApp @default(APPROVED)
  conteudo       String                 @db.Text // texto do componente BODY, com placeholders {{1}}
  // Preenchido pela Meta só quando status = REJECTED (rejected_reason da
  // Business Management API) — nunca inventado localmente.
  motivoRejeicao String?

  sincronizadoEm DateTime @default(now())

  @@map("templates_whatsapp")
}
