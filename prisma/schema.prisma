generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Cargo {
  ADMIN
  DIRETOR_ANALISTA
  ANALISTA
  GESTOR
  EXECUTIVO
}

model User {
  id    String @id @default(cuid())
  // Nome completo, derivado de firstName+lastName na criação — mantido só
  // porque o módulo de auth (NextAuth session/JWT) já lê esta coluna direto;
  // firstName/lastName são a fonte estruturada usada pelo módulo users.
  name  String
  email String @unique

  firstName String @default("")
  lastName  String @default("")
  phone     String @default("")
  cargo     Cargo  @default(ANALISTA)

  // Força a troca de senha no próximo login (definida na criação do
  // usuário ou quando uma senha temporária é gerada).
  mustChangePassword Boolean @default(false)

  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mensagensEnviadas    Mensagem[]
  atendimentosAgencia  AtendimentoAgencia[]
  textosProntosCriados TextoPronto[]
  passwordResetTokens  PasswordResetToken[]

  solicitacoesAgenciaFeitas             SolicitacaoAtendimentoAgencia[] @relation("SolicitacaoAgenciaSolicitante")
  solicitacoesAgenciaComoAtendenteAtual SolicitacaoAtendimentoAgencia[] @relation("SolicitacaoAgenciaAtendenteAtual")
  solicitacoesAgenciaComoNovoAtendente  SolicitacaoAtendimentoAgencia[] @relation("SolicitacaoAgenciaNovoAtendente")

  // Login de um Gestor/Executivo (Cargo.GESTOR/EXECUTIVO) — opcional porque
  // nem todo User é um desses cargos, e nem todo Gestor/Promotor tem login
  // (ver Gestor.userId/Promotor.userId, resolvidos no momento do cadastro).
  promotor     Promotor?
  gestorPerfil Gestor?

  @@map("users")
}

enum PasswordResetStatus {
  PENDING
  VERIFIED
  USED
}

// Recuperação de senha por OTP (6 dígitos) + token de link, ambos enviados
// por e-mail e nunca persistidos em texto puro (só sha256 em tokenHash/
// codigoHash — ver password-reset-hash.util.ts). A proteção real vem de
// expiraEm + tentativas + status USED (uso único), não do custo do hash.
model PasswordResetToken {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash  String @unique
  codigoHash String

  status       PasswordResetStatus @default(PENDING)
  tentativas   Int                 @default(0)
  verificadoEm DateTime?
  usadoEm      DateTime?
  expiraEm     DateTime

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

// ---------------------------------------------------------------------------
// Domínio de cadastro de agências. Fusão do schema normalizado descrito em
// prisma/schema.md e etapas/nullable.md (sem colunas JSON, uma tabela por
// conceito) com o que já está implementado e rodando em cima de `Agencia`:
// campos básicos obrigatórios (o wizard público já coleta tudo antes do
// submit), `contratoSocialPath` como coluna direta, `provedorId` genérico
// de provedor de assinatura, e `origemGeracao` por contrato.
//
// Tabelas/colunas do schema antigo que a UI atual ainda não popula (CADASTUR,
// vendas percentuais, gate de IA, kanban, decisões humanas, avanços forçados,
// notificações) continuam existindo, nullable, prontas pro roadmap de
// etapas/README.md sem quebrar o fluxo de hoje. `signatarios_padrao` já é
// populada (ver prisma/seed.ts) mas ainda não é lida pelo fluxo de contrato.
// ---------------------------------------------------------------------------

enum StatusAgencia {
  em_analise
  em_complementar
  aguardando_assinatura
  aguardando_validacao
  aguardando_cadastramento
  aguardando_ativacao
  ativo
  recusado
}

enum StatusContrato {
  aguardando_assinatura
  // Aprovador (papel APROVAR, estágio 1) assinou — sócios (estágio 0) já
  // tinham assinado antes dele. Falta só os signatários fixos restantes
  // (estágio 2, testemunhas) pra fechar; não bloqueia o avanço da agência.
  assinado_agencia
  assinado
  // Cancelado pelo analista (CancelarContratoUseCase, 2026-07-31) — a
  // Agencia volta pra em_complementar; se aprovarem de novo depois, gera
  // um Contrato NOVO (o registro cancelado fica só como histórico).
  cancelado
}

enum OrigemGeracaoContrato {
  ia
  humano
  // Documento criado/assinado fora do fluxo automático (direto no D4Sign,
  // ou fisicamente) e depois registrado na plataforma — ver
  // RegistrarContratoExternoUseCase.
  externo
}

enum TipoDocumento {
  CONTRATO_SOCIAL
  CADASTUR
  RG_CNPJ
  COMPROVANTE_ENDERECO
  COMPROVANTE_ENDERECO_AGENCIA
  CERTIDAO_CASAMENTO
  PROCURACAO
  OUTROS
}

enum StatusDocumento {
  PENDENTE
  APROVADO
  REPROVADO
}

enum PapelRepresentante {
  SOCIO
  PROCURADOR
}

enum TipoVenda {
  NACIONAL
  INTERNACIONAL
  TERRESTRE
}

enum EtapaDecisao {
  ANALISE
  COMPLEMENTAR
}

enum ResultadoDecisao {
  APROVADO
  REPROVADO
}

model Agencia {
  id                 String        @id @default(cuid())
  razaoSocial        String
  // Opcional (nem toda empresa tem nome fantasia distinto da razão
  // social) — coletado no wizard (Passo 2) e editável pelo analista, é a
  // versão "Cadastro" comparada contra stage1.nomeFantasia (Oficial) no
  // dossiê.
  nomeFantasia       String?
  cnpj               String        @unique
  etapaAtual         Int           @default(1)
  status             StatusAgencia @default(em_analise)
  contratoSocialPath String
  emailContato       String
  telefoneContato    String
  origem             String?
  // Id real do Promotor atribuído a essa agência (2026-07-25) — resolvido
  // no momento do cadastro tanto a partir do link pessoal do promotor
  // (uuid em Promotor.linkExecutivoId) quanto de um link de Evento
  // personalizado (Promotor.id direto, ver EventoLink). Sempre um id
  // canônico, nunca o uuid cru do parâmetro `?executivo=` — substitui o
  // antigo `promotorLinkId`. Null = nenhum executivo atribuído.
  executivoId        String?
  executivo          Promotor?     @relation(fields: [executivoId], references: [id])
  // Uma agência pertence a no máximo uma associação (1:N a partir de
  // Associacao) — decisão explícita do usuário, 2026-07-24.
  associacaoId       String?
  associacao         Associacao?   @relation(fields: [associacaoId], references: [id])
  // Evento (painel /eventos) de onde veio o cadastro, quando o link
  // personalizado usado carregava um `?evento=` — null = cadastro direto
  // ou via link pessoal de promotor sem evento (2026-07-25).
  eventoId           String?
  evento             Evento?       @relation(fields: [eventoId], references: [id])
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  // Confirmados manualmente pelo analista na etapa de Validação, antes de
  // liberar a Ativação — com log de quem confirmou e quando (mesmo padrão
  // de leituraConfirmadaPor/Em em Contrato).
  sicaCodigo         String?
  sicaSalvoPor       String?
  sicaSalvoEm        DateTime?
  travelLinkCriado   Boolean   @default(false)
  travelLinkSalvoPor String?
  travelLinkSalvoEm  DateTime?

  // Marca a última vez que quem estava EM ATENDIMENTO desta agência viu a
  // ficha (ver marcarAtualizacaoComoVista) — só abrir o dossiê sem estar
  // atendendo não atualiza isso (mesmo critério de "não dá pra espiar sem
  // assumir" já usado em atendimento/marcar-como-lida). "Tem atualização
  // pendente" = existe Notificacao(agenciaId) com createdAt depois disto
  // (ou null = nunca visto e já existe alguma notificação).
  atualizacaoVistaEm  DateTime?
  atualizacaoVistaPor String?

  // "Info pendente" — indiferente de status, marca que o analista está
  // esperando algo DA agência (oposto de atualizacaoVistaEm/Notificacao,
  // que é "a agência mandou algo, o analista que tem que olhar"). Liga em
  // SolicitarReenvioDocumentosUseCase (analista pediu reenvio); desliga
  // sozinha quando chega qualquer Notificacao dessa agência (ver
  // PrismaNotificacaoRepository.create) ou quando o status muda (ver
  // atualizarStatus) — nunca precisa ser desligada manualmente.
  infoPendente Boolean @default(false)

  complementar              CadastroComplementar?
  representantesLegais      RepresentanteLegal[]
  documentos                Documento[]
  contratos                 Contrato[]
  analiseIa                 AnaliseIaAgencia?
  dadosReceita              DadosReceita?
  gateValidacoes            GateValidacao[]
  alertas                   Alerta[]
  usuarioMaster             UsuarioMaster?
  avancosForcados           AvancoForcado[]
  historicoEtapaCadastro    HistoricoEtapaCadastro[]
  decisoesHumanas           DecisaoHumana[]
  notificacoes              Notificacao[]
  conversas                 Conversa[]
  historicoEdicoes          HistoricoEdicaoCadastro[]
  historicoConsultasCredito HistoricoConsultaCredito[]
  consultasSst              ConsultaSst[]
  atendimentosAgencia       AtendimentoAgencia[]
  solicitacoesAtendimento   SolicitacaoAtendimentoAgencia[]

  @@map("agencias")
}

// Cache normalizado da consulta à Receita Federal (CNPJ) — roadmap
// (etapas/README.md), não populado pelo fluxo atual.
model DadosReceita {
  id        String  @id @default(cuid())
  agenciaId String  @unique
  agencia   Agencia @relation(fields: [agenciaId], references: [id], onDelete: Cascade)

  situacaoCadastral String?
  dataAbertura      DateTime?
  naturezaJuridica  String?
  porte             String?
  capitalSocial     Decimal?  @db.Decimal(14, 2)
  telefone          String?
  email             String?
  optanteSimples    Boolean   @default(false)
  dataOpcaoSimples  DateTime?

  endereco Endereco?

  consultadoEm DateTime @default(now())

  cnaes Cnae[]

  @@map("dados_receita")
}

model Cnae {
  id             String       @id @default(cuid())
  dadosReceitaId String
  dadosReceita   DadosReceita @relation(fields: [dadosReceitaId], references: [id], onDelete: Cascade)
  codigo         String?
  descricao      String?
  principal      Boolean      @default(false)

  @@index([dadosReceitaId])
  @@map("cnaes")
}

// Resultado do gate automático de IA — roadmap, não populado hoje (a
// decisão da IA no fluxo atual mora só no `origemGeracao`/status do
// Contrato).
model GateValidacao {
  id             String   @id @default(cuid())
  agenciaId      String
  agencia        Agencia  @relation(fields: [agenciaId], references: [id], onDelete: Cascade)
  etapaAlvo      Int?
  liberado       Boolean?
  motivoBloqueio String?
  avaliadoEm     DateTime @default(now())

  @@index([agenciaId])
  @@map("gate_validacoes")
}

model Alerta {
  id          String    @id @default(cuid())
  agenciaId   String
  agencia     Agencia   @relation(fields: [agenciaId], references: [id], onDelete: Cascade)
  tipo        String?
  mensagem    String?
  criadoEm    DateTime  @default(now())
  resolvidoEm DateTime?

  @@index([agenciaId])
  @@map("alertas")
}

// Credencial de acesso da Etapa 4 (Usuário Master) — salvo de verdade
// pelo analista no dossiê (SalvarUsuarioMasterUseCase). `ativo` marca que
// existe um registro salvo (equivalente ao `salvo !== null` que a tela já
// calculava só localmente antes). `origemRepresentanteLegalId` é só
// referência de exibição (qual sócio, se houver, os dados vieram) — sem
// FK formal, não trava se o sócio for removido depois.
model UsuarioMaster {
  id                         String    @id @default(cuid())
  agenciaId                  String    @unique
  agencia                    Agencia   @relation(fields: [agenciaId], references: [id], onDelete: Cascade)
  nome                       String?
  email                      String?
  cpf                        String?
  telefone                   String?
  rg                         String?
  rgOrgaoEmissor             String?
  rgUf                       String?
  dataNascimento             DateTime?
  origemRepresentanteLegalId String?
  ativo                      Boolean   @default(false)
  salvoPor                   String?
  salvoEm                    DateTime?
  criadoEm                   DateTime  @default(now())

  @@map("usuarios_master")
}

// Compartilhado por três donos mutuamente exclusivos. O FK fica do lado
// do Endereco (nunca do lado do dono) pra que apagar o dono cascateie até
// aqui — ver prisma/schema.md pra o raciocínio completo.
model Endereco {
  id          String  @id @default(cuid())
  cep         String?
  logradouro  String?
  numero      String?
  complemento String?
  bairro      String?
  cidade      String?
  uf          String?

  dadosReceitaId String?       @unique
  dadosReceita   DadosReceita? @relation(fields: [dadosReceitaId], references: [id], onDelete: Cascade)

  cadastroComplementarId String?               @unique
  cadastroComplementar   CadastroComplementar? @relation(fields: [cadastroComplementarId], references: [id], onDelete: Cascade)

  representanteLegalId String?             @unique
  representanteLegal   RepresentanteLegal? @relation(fields: [representanteLegalId], references: [id], onDelete: Cascade)

  @@map("enderecos")
}

model CadastroComplementar {
  id        String  @id @default(cuid())
  agenciaId String  @unique
  agencia   Agencia @relation(fields: [agenciaId], references: [id], onDelete: Cascade)

  // Passo 2 — Empresa
  telefoneComercial String?
  emailOperacional  String?
  emailComercial    String?
  emailFinanceiro   String?

  // CADASTUR — roadmap, não coletado pela UI atual
  cadasturNumero       String?
  cadasturDataCadastro DateTime?
  cadasturValidade     DateTime?
  cadasturSituacao     String?

  // Passo 3 — Comercial — roadmap. `clienteInternacional` nunca é
  // persistido: é sempre o inverso de `resideBrasil`, derivado na
  // aplicação.
  resideBrasil Boolean?

  // Passo 6 — Endereço da agência & Banco
  tipoAgencia                 String?
  enderecoAgencia             Endereco?
  enderecoAgenciaMesmoTitular Boolean?
  socioVinculadoEnderecoId    String?
  socioVinculadoEndereco      RepresentanteLegal? @relation("SocioVinculadoEndereco", fields: [socioVinculadoEnderecoId], references: [id])

  bancoPais           String?
  bancoNome           String?
  bancoCodigo         String?
  bancoAgencia        String?
  bancoConta          String?
  bancoSwift          String?
  tipoConta           String?
  favorecidoEhEmpresa Boolean?
  favorecidoNome      String?
  favorecidoDoc       String?

  // Roadmap (schema antigo), não usado pela UI atual
  chavePix         String?
  tipoChavePix     String?
  tipoFaturamento  String?
  percCorporativo  Decimal? @db.Decimal(5, 2)
  percConvencional Decimal? @db.Decimal(5, 2)

  submetidoAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vendasPercentuais VendaPercentual[]

  @@map("cadastros_complementares")
}

// Roadmap — substitui os JSONs paralelos de vendas por tipo/percentual;
// não populado pela UI atual.
model VendaPercentual {
  id                     String               @id @default(cuid())
  cadastroComplementarId String
  cadastroComplementar   CadastroComplementar @relation(fields: [cadastroComplementarId], references: [id], onDelete: Cascade)
  tipo                   TipoVenda?
  percentual             Decimal?             @db.Decimal(5, 2)

  @@unique([cadastroComplementarId, tipo])
  @@map("venda_percentuais")
}

model RepresentanteLegal {
  id        String  @id @default(cuid())
  agenciaId String
  agencia   Agencia @relation(fields: [agenciaId], references: [id], onDelete: Cascade)

  nome                 String
  email                String
  telefone             String
  cpf                  String
  cnpj                 String?
  isPj                 Boolean            @default(false)
  rg                   String?
  rgOrgaoEmissor       String?
  dataNascimento       DateTime?
  estadoCivil          String
  regimeBens           String?
  nacionalidade        String?
  cargo                String?
  papel                PapelRepresentante @default(SOCIO)
  // Sócio marcado como representante legal da empresa (libera o slot de
  // Procuração no wizard) — distinto de `papel`, que é pra um procurador
  // terceiro fora do quadro societário (roadmap, não usado hoje).
  isRepresentanteLegal Boolean            @default(false)
  // Sócio administrador/quem assina o contrato — extraído pela IA do
  // contrato social (SocioContratoSocialExtraido.administrativo), editável
  // pelo analista no painel. null (ainda não avaliado) e true assinam;
  // só false exclui o sócio da lista de signatarios do contrato.
  administrativo       Boolean?
  ativo                Boolean            @default(true)
  origem               String?
  preenchidoPorIa      Boolean            @default(false)

  endereco Endereco?
  conjuge  Conjuge?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documentos                Documento[]
  contratoSignatarios       ContratoSignatario[]
  enderecosAgenciaVinculada CadastroComplementar[] @relation("SocioVinculadoEndereco")
  conversas                 Conversa[]

  // Sem unique: a mesma pessoa (CPF) pode ser sócia em agências
  // diferentes ao mesmo tempo — CPF duplicado DENTRO da mesma agência é
  // barrado antes, na validação de finalizarCadastroMetaSchema (ver
  // schema.ts), não pelo banco.
  @@index([agenciaId, cpf])
  @@map("representantes_legais")
}

// Roadmap (Passo 5, PF casado) — não coletado pela UI atual.
model Conjuge {
  id                   String             @id @default(cuid())
  representanteLegalId String             @unique
  representanteLegal   RepresentanteLegal @relation(fields: [representanteLegalId], references: [id], onDelete: Cascade)
  nome                 String?
  cpf                  String?
  rg                   String?
  nacionalidade        String?

  @@map("conjuges")
}

model Documento {
  id        String  @id @default(cuid())
  agenciaId String
  agencia   Agencia @relation(fields: [agenciaId], references: [id], onDelete: Cascade)

  representanteLegalId String?
  representanteLegal   RepresentanteLegal? @relation(fields: [representanteLegalId], references: [id])

  tipo           TipoDocumento
  fileName       String?
  mimeType       String?
  // Descrição livre digitada pelo analista — só preenchida quando
  // tipo = OUTROS (documento sem slot fixo no dossiê).
  descricaoOutro String?

  // Caminho retornado pelo FileStorage (local hoje, GCS futuramente).
  // Bucket/tamanho/hash ficam nullable porque o LocalFileStorage atual
  // não produz esses metadados.
  gcsPath   String
  gcsBucket String?
  gcsSize   Int?
  gcsMd5    String?

  status                 StatusDocumento @default(PENDENTE)
  verificado             Boolean         @default(false)
  reprovadoPor           String?
  motivoReprovacao       String?
  reprovadoEm            DateTime?
  // Simétrico ao trio de reprovação acima — aprovação manual (analista)
  // passou a exigir justificativa igual à reprovação: se um humano decidiu
  // aprovar em vez de deixar a IA seguir sozinha, algo levou a essa
  // exceção, então quem/quando/por quê ficam registrados do mesmo jeito
  // (decisão do usuário, 2026-07-26).
  aprovadoPor            String?
  motivoAprovacao        String?
  aprovadoEm             DateTime?
  // Quem fez upload manual pelo dossiê (painel admin), preenchendo um slot
  // vazio ou reprovado — null quando o arquivo veio do wizard público ou
  // do reenvio do próprio cliente.
  inseridoManualmentePor String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  analiseIa AnaliseIaDocumento?

  @@index([agenciaId])
  @@map("documentos")
}

// Espelha DocumentAnalysisResultado (o retorno do FlysakuraDocumentAnalysisAdapter)
// pra qualquer document_type (contrato_social, cnh_rg, ...) — não um schema fixo
// tipo CADASTUR, já que o agente decide as chaves de `campos`/`camposExtras`
// dinamicamente por tipo de documento/sociedade. Gravado por
// AgenciaRepository.registrarAnaliseDocumento, chamado de AnalisarCadastroUseCase.
model AnaliseIaDocumento {
  id          String    @id @default(cuid())
  documentoId String    @unique
  documento   Documento @relation(fields: [documentoId], references: [id], onDelete: Cascade)

  camposExtraidos             Json
  camposExtras                Json
  confiancaExtracao           Decimal  @db.Decimal(5, 2)
  alertas                     String[]
  resumoAnalise               String?
  textoBruto                  String?
  formatoValido               Boolean?
  camposObrigatoriosPresentes Boolean?
  referenciaCruzadaOk         Boolean?
  // Veredito da IA sobre esse documento específico (independente do parecer
  // final de agência em AnaliseIaAgencia) — só populado quando include_verdict
  // foi pedido (default true, ver DocumentAnalysisInput).
  parecer                     String?
  // Comparação campo a campo com fonte oficial (Receita) — só populado quando
  // include_official_data foi pedido E o document_type tem fonte oficial
  // disponível (hoje: só contrato_social, ver docs/agency-analysis-params-tracking.md).
  comparacaoOficial           Json?
  detalhesChecagem            Json?

  processadoEm DateTime @default(now())

  @@map("analises_ia_documentos")
}

// Log de edição em lote dos dados de cadastro pelo analista (sócio ou
// empresa) — exige justificativa (ver EditarRepresentanteLegalUseCase/
// EditarDadosEmpresaUseCase), então cobre tanto "o que" quanto "por quê"
// mudou, não só o antes/depois. `entidade`/`entidadeId` são referência
// solta (string livre, sem FK formal — mesmo padrão de
// HistoricoEtapaCadastro.origem/Alerta.tipo), já que uma linha aqui pode apontar
// pra RepresentanteLegal, Agencia ou CadastroComplementar. `alteracoes` é
// Json porque o conjunto de campos editados varia por chamada (mesma
// razão de AnaliseIaDocumento.detalhesChecagem ser Json).
model HistoricoEdicaoCadastro {
  id        String  @id @default(cuid())
  agenciaId String
  agencia   Agencia @relation(fields: [agenciaId], references: [id], onDelete: Cascade)

  entidade   String // "RepresentanteLegal" | "Agencia" | "CadastroComplementar"
  entidadeId String

  alteracoes    Json // { campo: { de: string|null, para: string|null } }
  justificativa String @db.Text
  editadoPor    String

  createdAt DateTime @default(now())

  @@index([agenciaId])
  @@index([entidadeId])
  @@map("historico_edicoes_cadastro")
}

// Auditoria de reconsultas manuais de AMAT/SOFIA (ver ReconsultarCreditoUseCase)
// — cada clique no botão "Reconsultar" de um dos dois cards vira uma linha
// aqui, preservando quem consultou e quando mesmo depois que
// AnaliseIaAgencia.stage2/rawData for sobrescrito pela consulta seguinte
// (aquela tabela é 1:1 por agência, só o estado atual — ver comentário lá).
// `resultado`/`rawResultado` guardam o snapshot só da fonte consultada
// (AnaliseIaAmat ou o dict da SOFIA), não o stage2 completo.
model HistoricoConsultaCredito {
  id        String  @id @default(cuid())
  agenciaId String
  agencia   Agencia @relation(fields: [agenciaId], references: [id], onDelete: Cascade)

  fonte String // "AMAT" | "SOFIA"

  sucesso      Boolean
  erro         String?
  resultado    Json?
  rawResultado Json?

  consultadoPor String

  createdAt DateTime @default(now())

  @@index([agenciaId, fonte])
  @@map("historico_consultas_credito")
}

enum SicaEmpresaStatus {
  ativo
  inativo
}

enum SicaMetodoConsulta {
  cnpj
  codigo_empresa
}

// Consulta ao SST (sst.flysakura.com — Sica/Sigot/TravelLink) — verifica se
// a empresa já está cadastrada no SICA. Mesma checagem, disparada em
// momentos diferentes: automática por CNPJ ao finalizar o cadastro (ver
// AnalisarCadastroUseCase — cadastro novo normalmente não tem SICA ainda;
// achar algo aqui é sinal de recadastro), ou manual por código quando o
// analista confirma o SICA (ver SalvarSicaUseCase — cruza o CNPJ retornado
// contra o da agência pra evitar salvar o código de outra empresa por
// engano). Uma linha por consulta (nunca sobrescreve) — a mais recente é
// "o valor atual", histórico completo preservado sem precisar de tabela
// separada (mesmo espírito de HistoricoConsultaCredito, mas sem a
// duplicação current+histórico: aqui não existe um "AnaliseIaAgencia" pra
// esse dado morar dentro).
model ConsultaSst {
  id        String  @id @default(cuid())
  agenciaId String
  agencia   Agencia @relation(fields: [agenciaId], references: [id], onDelete: Cascade)

  sucesso Boolean // false = a chamada ao SST falhou tecnicamente
  erro    String?
  metodo  SicaMetodoConsulta

  encontrado      Boolean
  codigoEmpresa   Int?
  nomeEmpresa     String?
  telefone        String?
  email           String?
  empresaStatus   SicaEmpresaStatus?
  codigoExecutivo Int?
  nomeExecutivo   String?

  // null = disparado automaticamente pelo pipeline; preenchido = analista
  // (reconsulta manual ou confirmação do código SICA).
  consultadoPor String?

  createdAt DateTime @default(now())

  @@index([agenciaId])
  @@map("consultas_sst")
}

// Classificação de por que a agência chegou no status atual — distingue
// um REPROVADO de verdade (a IA avaliou e disse não) de uma falha técnica
// que nunca chegou a produzir um parecer real (FALHA_ANALISE) ou de uma
// aprovação cujo contrato não pôde ser gerado/enviado (FALHA_CONTRATO).
// EM_ANALISE é o valor inicial, gravado já na persistência do cadastro
// (junto da Agencia, status "em_analise") — a linha nunca fica ausente
// pra um cadastro que já foi persistido; registrarAnaliseFinal só
// atualiza pra um dos outros três quando a IA termina.
// Adicionado em 2026-07-24 junto do fluxo assíncrono de análise (ver
// AnalisarCadastroUseCase) — antes disso só existia o texto livre em
// `motivo`, sem como diferenciar programaticamente os três casos.
enum ResultadoAnaliseIa {
  EM_ANALISE
  APROVADO
  REPROVADO
  FALHA_ANALISE
  FALHA_CONTRATO
}

// Veredito (ou estado atual) do /agency-analysis/sync
// (parecer/justificativa/flags_risco + stage3, o cruzamento
// documento×fonte oficial×fornecido) — uma linha por agência, criada já
// na persistência do cadastro (resultado=EM_ANALISE) e atualizada quando
// a IA termina. Existe pra dar contexto real ao analista quando o
// parecer não é APROVADO, em vez de só o status "em_complementar" sem
// explicação.
model AnaliseIaAgencia {
  id        String  @id @default(cuid())
  agenciaId String  @unique
  agencia   Agencia @relation(fields: [agenciaId], references: [id], onDelete: Cascade)

  resultado    ResultadoAnaliseIa
  parecer      String?
  motivo       String?
  flagsRisco   String[]
  // Razões estruturadas (enum) por trás do parecer — ex.: AMAT_DIVIDA,
  // DOCUMENTO_VENCIDO, CNPJ_INATIVO (ver agency_analysis_reasons.py do
  // agents-service). Complementa flagsRisco (texto livre do agente) com
  // valores filtráveis; adicionado em 2026-08-05 junto da mudança do
  // agents-service que parou de reprovar automaticamente por dívida
  // AMAT/SOFIA (parecer final passou a ser 100% do LLM).
  razoes       String[]
  detalhamento Json?
  // Stage1 (verificação cadastral — situação, CNAE principal/secundários
  // com compatibilidade de turismo, e comparação fornecido x oficial de
  // razão social/nome fantasia/e-mail/sócios) — ver AnaliseIaStage1 em
  // analise-ia-service.ts. Já vinha mapeado no adapter desde antes, só não
  // era persistido.
  stage1       Json?
  // Stage2 (crédito — AMAT tipado + sofia/processos/reclamações como dict
  // livre) e as chamadas de tool brutas (raw_data, quando
  // `include_raw_data: true`) — ver AnaliseIaStage2/AnaliseIaRawData em
  // analise-ia-service.ts. Adicionados em 2026-07-27 junto da integração
  // real de AMAT/SOFIA (substitui mock-amat-sofia.util.ts).
  stage2       Json?
  rawData      Json?

  avaliadoEm DateTime @default(now())

  @@map("analises_ia_agencias")
}

model Contrato {
  id            String                @id @default(cuid())
  agenciaId     String
  agencia       Agencia               @relation(fields: [agenciaId], references: [id], onDelete: Cascade)
  provedorId    String
  status        StatusContrato        @default(aguardando_assinatura)
  origemGeracao OrigemGeracaoContrato

  numContrato        String? @unique
  conteudoPreenchido String? @db.Text

  leituraConfirmada    Boolean   @default(false)
  leituraConfirmadaPor String?
  leituraConfirmadaEm  DateTime?

  contratoGcsPath    String?
  pdfAssinadoGcsPath String?
  assinadoAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  signatarios        ContratoSignatario[]
  emailsFalhaEntrega ContratoEmailFalhaEntrega[]
  assinaturas        ContratoAssinatura[]

  @@index([agenciaId])
  @@map("contratos")
}

// Log de assinatura individual (D4Sign webhook, type_post=4) — por
// e-mail, mesmo racional do ContratoEmailFalhaEntrega: cobre sócios e
// signatários fixos da Sakura sem depender de CPF. @@unique pra upsert
// idempotente em retries do D4Sign — mas aqui o assinadoEm ORIGINAL é
// preservado (retry não reescreve a data da assinatura).
// Linha = "destinatário conhecido deste contrato" (não necessariamente já
// assinado — ver assinadoEm). `registrar` (assinatura de verdade, webhook
// ou sync) seta assinadoEm; `registrarDestinatario` (sync, alguém que o
// D4Sign já lista mas ainda não assinou) só grava email/keySigner, nunca
// mexe em assinadoEm. Todo código que lê esta tabela pra decidir "quem já
// assinou" precisa filtrar por `assinadoEm != null` explicitamente — ver
// assinatura-socios.util.ts.
model ContratoAssinatura {
  id         String    @id @default(cuid())
  contratoId String
  contrato   Contrato  @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  email      String
  assinadoEm DateTime?

  // ID do signatário no D4Sign (`key_signer` na resposta de
  // GET /documents/{uuid}/list, e também do POST .../createlist — vem
  // pra todo destinatário desde o cadastro, antes de qualquer assinatura).
  // Pré-requisito pra futuramente buscar o link de assinatura individual:
  // GET /documents/{uuid}/signaturelink/{id}, onde {id} é o key_signer
  // DECODIFICADO DE BASE64 (não o valor cru salvo aqui) — confirmado na
  // doc oficial do D4Sign, 2026-07-31. Busca do link em si é escopo futuro.
  keySigner String?

  // Setado pelo sync quando esse destinatário some da lista do D4Sign —
  // não apaga o registro, só sinaliza. Limpo de volta (null) se reaparecer.
  removidoDoDocumentoEm DateTime?

  @@unique([contratoId, email])
  @@map("contrato_assinaturas")
}

// Registro de "e-mail não entregue" (D4Sign webhook, type_post=2) — por
// e-mail, não por ContratoSignatario/SignatarioPadrao: cobre tanto os
// sócios quanto os 4 signatários fixos da Sakura sem depender de CPF (que
// os fixos não têm). @@unique pra upsert idempotente em retries do
// D4Sign — o motivo/data mais recentes sobrescrevem o registro anterior.
model ContratoEmailFalhaEntrega {
  id         String   @id @default(cuid())
  contratoId String
  contrato   Contrato @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  email      String
  motivo     String?
  criadoEm   DateTime @default(now())

  @@unique([contratoId, email])
  @@map("contrato_email_falha_entrega")
}

// Snapshot imutável do signatário no momento em que o contrato foi
// gerado — se o sócio corrigir o endereço em RepresentanteLegal depois,
// o contrato já emitido não muda retroativamente.
model ContratoSignatario {
  id         String   @id @default(cuid())
  contratoId String
  contrato   Contrato @relation(fields: [contratoId], references: [id], onDelete: Cascade)

  representanteLegalId String?
  representanteLegal   RepresentanteLegal? @relation(fields: [representanteLegalId], references: [id])
  signatarioPadraoId   String?
  signatarioPadrao     SignatarioPadrao?   @relation(fields: [signatarioPadraoId], references: [id])

  nome           String
  email          String
  cpf            String
  rg             String?
  rgOrgaoEmissor String?
  cargo          String?
  nacionalidade  String?
  estadoCivil    String?
  dataNascimento DateTime?

  cepSnapshot         String?
  logradouroSnapshot  String?
  numeroSnapshot      String?
  complementoSnapshot String?
  bairroSnapshot      String?
  cidadeSnapshot      String?
  ufSnapshot          String?

  camposPendentes ContratoCampoPendente[]

  @@index([contratoId])
  @@map("contrato_signatarios")
}

// Roadmap — pendências ignoradas quando o contrato é gerado com
// "force: true"; não usado pela UI atual.
model ContratoCampoPendente {
  id                   String             @id @default(cuid())
  contratoSignatarioId String
  contratoSignatario   ContratoSignatario @relation(fields: [contratoSignatarioId], references: [id], onDelete: Cascade)
  campo                String?

  @@map("contrato_campos_pendentes")
}

// Roadmap — histórico de overrides manuais de etapa; não usado hoje.
model AvancoForcado {
  id                 String   @id @default(cuid())
  agenciaId          String
  agencia            Agencia  @relation(fields: [agenciaId], references: [id], onDelete: Cascade)
  etapaAlvo          Int?
  motivo             String?
  gateMotivoBloqueio String?
  statusReal         String?
  solicitadoPor      String?
  autorizadoPor      String?
  createdAt          DateTime @default(now())

  pendencias AvancoForcadoPendencia[]

  @@index([agenciaId])
  @@map("avancos_forcados")
}

model AvancoForcadoPendencia {
  id              String        @id @default(cuid())
  avancoForcadoId String
  avancoForcado   AvancoForcado @relation(fields: [avancoForcadoId], references: [id], onDelete: Cascade)
  descricao       String?

  @@map("avanco_forcado_pendencias")
}

// Log de auditoria de toda transição de Agencia.status — grava quem/o que
// causou cada mudança (analista, IA, webhook do D4Sign, ou o próprio
// cadastro sendo criado) e quando, pra medir SLA (tempo em cada etapa) e
// auditoria (ver AgenciaRepository.atualizarStatus/registrarAnaliseFinal e
// FinalizarCadastroUseCase). `statusAnterior: null` marca o registro
// inicial (criação do cadastro, sem etapa anterior).
model HistoricoEtapaCadastro {
  id                String         @id @default(cuid())
  agenciaId         String
  agencia           Agencia        @relation(fields: [agenciaId], references: [id], onDelete: Cascade)
  statusAnterior    StatusAgencia?
  statusNovo        StatusAgencia?
  usuarioEmail      String?
  origem            String?
  observacao        String?
  desbloqueioManual Boolean?
  detalhes          String?        @db.Text
  createdAt         DateTime       @default(now())

  @@index([agenciaId])
  @@map("historico_etapa_cadastro")
}

// Roadmap — decisão manual de aprovação/reprovação em qualquer etapa com
// gate humano; não usado hoje (aprovação manual mora em
// AprovarCadastroComplementarUseCase, sem log próprio ainda).
model DecisaoHumana {
  id            String            @id @default(cuid())
  agenciaId     String
  agencia       Agencia           @relation(fields: [agenciaId], references: [id], onDelete: Cascade)
  etapa         EtapaDecisao?
  decisaoIa     String?
  decisaoHumana ResultadoDecisao?
  justificativa String?           @db.Text
  usuarioEmail  String?
  modeloIa      String?
  scoreIa       Float?
  divergiu      Boolean?
  createdAt     DateTime          @default(now())

  @@index([agenciaId])
  @@map("decisoes_humanas")
}

// Roadmap — não usado hoje.
model Notificacao {
  id        String   @id @default(cuid())
  agenciaId String
  agencia   Agencia  @relation(fields: [agenciaId], references: [id], onDelete: Cascade)
  tipo      String?
  titulo    String?
  mensagem  String?
  createdAt DateTime @default(now())

  @@index([agenciaId])
  @@map("notificacoes")
}

// Signatários fixos da Sakura (mesmos em todo contrato). `papel` é o ato no
// D4Sign (catálogo completo do campo `act` da API, não só os usados hoje) e
// `estagio` é o after_position da fila de assinatura — estágio 0 é sempre os
// sócios da agência (dinâmico, fora desta tabela); os fixos ocupam os
// estágios seguintes. `deletedAt` é o padrão de soft delete pra essa tabela
// (e daqui pra frente, pro projeto): null = ativo, preenchido = removido
// (reversível — `findAtivos` filtra por `deletedAt: null`).
model SignatarioPadrao {
  id        String                @id @default(cuid())
  nome      String?
  cargo     String?
  email     String?               @unique
  telefone  String?
  deletedAt DateTime?
  ordem     Int?
  papel     PapelSignatarioPadrao
  estagio   Int

  contratoSignatarios ContratoSignatario[]

  @@map("signatarios_padrao")
}

// Espelha 1:1 o campo `act` da API do D4Sign (https://docapi.d4sign.com.br/,
// tabela de "Ações permitidas") — cada valor é o ato do signatário no
// documento. Hoje só APROVAR, ASSINAR_COMO_PARTE e ASSINAR_COMO_TESTEMUNHA
// são usados pelos 4 signatários fixos da Sakura; o resto existe pra manter
// o enum fiel ao catálogo real da API, sem precisar de nova migration se um
// papel diferente entrar em uso.
enum PapelSignatarioPadrao {
  ASSINAR // act=1
  APROVAR // act=2
  RECONHECER // act=3
  ASSINAR_COMO_PARTE // act=4
  ASSINAR_COMO_TESTEMUNHA // act=5
  ASSINAR_COMO_INTERVENIENTE // act=6
  ACUSAR_RECEBIMENTO // act=7
  ASSINAR_COMO_EMISSOR_ENDOSSANTE_AVALISTA // act=8
  ASSINAR_COMO_EMISSOR_ENDOSSANTE_AVALISTA_FIADOR // act=9
  ASSINAR_COMO_FIADOR // act=10
  ASSINAR_COMO_PARTE_E_FIADOR // act=11
  ASSINAR_COMO_RESPONSAVEL_SOLIDARIO // act=12
  ASSINAR_COMO_PARTE_E_RESPONSAVEL_SOLIDARIO // act=13
}

// ---------------------------------------------------------------------------
// Domínio de Atendimento (WhatsApp / Meta Cloud API) — conversas entre
// analistas e contatos das agências (sócios/representantes/comercial), com
// histórico de mensagens (texto/áudio/imagem/pdf) e de "assumir
// atendimento". Espelha o contrato de tipos consumido pelo front em
// src/modules/atendimento/types/atendimento.types.ts.
// ---------------------------------------------------------------------------

enum TipoContatoConversa {
  AGENCIA
  NAO_IDENTIFICADO
}

enum PapelMembroConversa {
  SOCIO
  REPRESENTANTE_LEGAL
  COMERCIAL
  OUTRO
}

enum TipoMensagemWhatsApp {
  TEXTO
  AUDIO
  IMAGEM
  PDF
}

enum AutorMensagem {
  CLIENTE
  ANALISTA
}

enum StatusEntregaMensagem {
  ENVIADO
  ENTREGUE
  LIDO
  FALHOU
}

enum StatusTemplateWhatsApp {
  APPROVED
  PENDING
  REJECTED
  PAUSED
}

// Uma linha por número de telefone WhatsApp (wa_id) com histórico de troca
// de mensagens. agenciaId nullable + tipoContato cobrem o caso "não
// identificado" (decisão de produto 2026-07-23): quando o número inbound
// não bate com RepresentanteLegal.telefone / Agencia.telefoneContato /
// CadastroComplementar.telefoneComercial, a conversa é criada mesmo assim
// (nunca descartada), com agenciaId = null e tipoContato =
// NAO_IDENTIFICADO, pra aparecer na aba "não identificado" do front.
model Conversa {
  id          String              @id @default(cuid())
  tipoContato TipoContatoConversa @default(AGENCIA)

  agenciaId String?
  agencia   Agencia? @relation(fields: [agenciaId], references: [id], onDelete: Cascade)

  telefoneWhatsapp String @unique // wa_id — E.164 dígitos, sem "+"

  // Snapshot de exibição (nome/papel) do momento do match de contato — não
  // é FK formal pro membro porque contatos "não identificados" não têm
  // representante nenhum vinculado.
  membroNome     String?
  membroPapel    PapelMembroConversa @default(OUTRO)
  membroTelefone String

  representanteLegalId String?
  representanteLegal   RepresentanteLegal? @relation(fields: [representanteLegalId], references: [id])

  mensagens Mensagem[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastMessageAt DateTime?

  @@index([agenciaId])
  @@index([tipoContato])
  @@map("conversas")
}

model Mensagem {
  id         String   @id @default(cuid())
  conversaId String
  conversa   Conversa @relation(fields: [conversaId], references: [id], onDelete: Cascade)

  autor      AutorMensagem
  analistaId String?
  // Analista que enviou — FK real pro User (nunca string livre vinda do
  // cliente); nullable porque mensagens do cliente (autor = CLIENTE) não
  // têm analista.
  analista   User?         @relation(fields: [analistaId], references: [id])

  tipo                TipoMensagemWhatsApp
  conteudo            String               @db.Text // texto puro, ou caption/nome de arquivo p/ mídia
  duracaoSegundos     Int? // só tipo = AUDIO
  tamanhoArquivoBytes Int? // só tipo != TEXTO — front formata pra exibição

  midiaId String?        @unique
  midia   MensagemMidia? @relation(fields: [midiaId], references: [id])

  lido   Boolean               @default(false)
  status StatusEntregaMensagem @default(ENVIADO)

  // Id da mensagem no WhatsApp Cloud API — outbound (msg que nós mandamos)
  // ou inbound (msg do cliente) — chave de idempotência do webhook (Meta
  // redelivera eventos em retry).
  waMessageId String? @unique

  createdAt DateTime @default(now())

  @@index([conversaId])
  @@index([conversaId, createdAt])
  @@map("mensagens")
}

// Metadados do arquivo de mídia baixado do WhatsApp e salvo via
// FileStorage (mesmo padrão de Documento: gcsPath/gcsBucket/gcsSize/
// gcsMd5). Tabela própria (não colunas soltas em Mensagem) pra manter
// Mensagem enxuta.
model MensagemMidia {
  id       String    @id @default(cuid())
  mensagem Mensagem?

  fileName String?
  mimeType String?

  gcsPath   String
  gcsBucket String?
  gcsSize   Int?
  gcsMd5    String?

  createdAt DateTime @default(now())

  @@map("mensagens_midia")
}

// Responsabilidade sobre a AGÊNCIA (o cadastro em si) — independente de
// conversa de WhatsApp existir ou não (ex.: analista revisando um dossiê
// reprovado pela IA, sem nunca ter falado com o cliente). É o registro que
// trava ações de edição/aprovação/reprovação no dossiê e de iniciar/enviar
// mensagem no atendimento — decisão do usuário, 2026-07-28. Atendimento é
// sempre da agência, em qualquer canal (chat ou dossiê) — unificado em
// 2026-07-30 (antes o chat tinha seu próprio registro por conversa,
// AssumirAtendimentoRegistro, removido nessa unificação).
model AtendimentoAgencia {
  id        String  @id @default(cuid())
  agenciaId String
  agencia   Agencia @relation(fields: [agenciaId], references: [id], onDelete: Cascade)

  analistaId String
  analista   User   @relation(fields: [analistaId], references: [id])

  assumidoEm DateTime  @default(now())
  liberadoEm DateTime?

  @@index([agenciaId])
  @@map("atendimentos_agencia")
}

enum TipoSolicitacaoAtendimentoAgencia {
  TRANSFERENCIA
  ASSUNCAO
}

enum StatusSolicitacaoAtendimentoAgencia {
  PENDENTE
  ACEITA
  CANCELADA
}

// Pedido de troca do responsável pelo atendimento da agência (AtendimentoAgencia
// acima) — vale pra qualquer canal (chat ou dossiê), atendimento é sempre
// da agência. Dois tipos: TRANSFERENCIA (só quem atende pode abrir, escolhe o destino) e
// ASSUNCAO (só quem NÃO atende pode abrir, contra quem atende agora, sem
// escolher destino — é sempre quem pediu). Em ambos, o efeito de ACEITA é
// sempre o mesmo: liberar atendenteAtualId e criar um AtendimentoAgencia novo
// pra novoAtendenteId — nunca inverter isso entre os dois tipos, é o que evita
// trocar os polos. "Tempo esgotar sem cancelar" = sucesso (ACEITA), por isso
// não existe status EXPIRADA — resolvidaPorExpiracao só registra COMO chegou
// a ACEITA (auditoria/exibição, não muda o efeito).
model SolicitacaoAtendimentoAgencia {
  id        String  @id @default(cuid())
  agenciaId String
  agencia   Agencia @relation(fields: [agenciaId], references: [id], onDelete: Cascade)

  tipo TipoSolicitacaoAtendimentoAgencia

  // Quem abriu o pedido — sempre tem botão Cancelar.
  solicitanteId String
  solicitante   User   @relation("SolicitacaoAgenciaSolicitante", fields: [solicitanteId], references: [id])

  // Quem está atendendo no momento da criação — liberado se ACEITA.
  atendenteAtualId String
  atendenteAtual   User   @relation("SolicitacaoAgenciaAtendenteAtual", fields: [atendenteAtualId], references: [id])

  // Quem fica atendendo se ACEITA — destino escolhido (TRANSFERENCIA) ou o
  // próprio solicitante (ASSUNCAO, sempre === solicitanteId nesse caso).
  novoAtendenteId String
  novoAtendente   User   @relation("SolicitacaoAgenciaNovoAtendente", fields: [novoAtendenteId], references: [id])

  status   StatusSolicitacaoAtendimentoAgencia @default(PENDENTE)
  criadaEm DateTime                            @default(now())

  resolvidaEm           DateTime?
  resolvidaPorExpiracao Boolean   @default(false)

  @@index([agenciaId])
  @@index([solicitanteId])
  @@index([atendenteAtualId])
  @@index([novoAtendenteId])
  @@map("solicitacoes_atendimento_agencia")
}

// Textos prontos (respostas rápidas) — globais, CRUD simples.
model TextoPronto {
  id          String   @id @default(cuid())
  titulo      String
  conteudo    String   @db.Text
  criadoPorId String?
  criadoPor   User?    @relation(fields: [criadoPorId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("textos_prontos")
}

// Cache local dos templates aprovados na Meta (Business Management API
// "message_templates"). Preferido a config-only (exigiria deploy pra cada
// template novo aprovado) ou fetch ao vivo a cada listagem (acopla a
// listagem à latência/disponibilidade da Graph API) — populado por
// SincronizarTemplatesWhatsAppUseCase via upsert por metaTemplateId.
model TemplateWhatsApp {
  id             String                 @id @default(cuid())
  metaTemplateId String                 @unique
  nome           String
  // Nome amigável definido localmente pro analista reconhecer o template
  // na lista — `nome` continua sendo o nome técnico real da Meta (não dá
  // pra mudar, é a chave de envio), `titulo` é só de exibição e nunca é
  // mandado pra Graph API.
  titulo         String?
  idioma         String                 @default("pt_BR")
  categoria      String?
  status         StatusTemplateWhatsApp @default(APPROVED)
  // Liga/desliga o template só do nosso lado (some do picker de envio em
  // ThreadConversa) sem tocar no status dele na Meta — diferente de
  // PAUSED, que é decisão da Meta por qualidade, não do analista.
  ativo          Boolean                @default(true)
  conteudo       String                 @db.Text // texto do componente BODY, com placeholders {{1}}
  // Preenchido pela Meta só quando status = REJECTED (rejected_reason da
  // Business Management API) — nunca inventado localmente.
  motivoRejeicao String?

  sincronizadoEm DateTime @default(now())

  @@map("templates_whatsapp")
}

// Fonte real (planilha "Links Promotores.xlsx", aba Promotores) de quem
// é cada executivo/gestor comercial — substitui o mock em memória de
// nomes abreviados/apelidos de cidades-mapa-comercial.json como
// identidade (decisão do usuário, 2026-07-24): todo promotor tem `sica`
// (não opcional), o mock de cidades continua só como fonte de
// base/cidade/região atendida, cruzado por nome.
model Promotor {
  id              String   @id @default(cuid())
  // Nullable — só existe na planilha "Links Promotores.xlsx"; promotores
  // vindos só do export "gerentes_conta" (sistema anterior, 2026-07-27,
  // ex.: Marcel Mazzonetto, Luis Vargas) não têm SICA, não inventado.
  sica            Int?     @unique
  nome            String
  // Gestor responsável por este executivo (model próprio, 2026-08-03) —
  // resolvido no cadastro (form /promotores) ou pelo backfill/seed a partir
  // do nome anotado na planilha original (ver prisma/scripts/backfill-gestores.ts
  // e prisma/seeds/promotores.ts). Null = ainda não atribuído.
  gestorId        String?
  gestor          Gestor?  @relation(fields: [gestorId], references: [id])
  // Chave de upsert do seed (ver prisma/seeds/promotores.ts) — único
  // porque promotores sem SICA (acima) precisam de outra chave estável.
  email           String   @unique
  // Nullable — 7 dos 81 registros da planilha de origem vêm sem
  // telefone preenchido; não inventado.
  telefone        String?
  // Nullable — mesma razão do sica: promotores só do export
  // "gerentes_conta" não têm link pessoal de cadastro.
  link            String?
  // uuid(s) do parâmetro `?executivo=` extraído(s) de `link` — chave real
  // de atribuição automática: um cadastro feito por um desses links vira
  // dessa pessoa (e do gestor/base dela) automaticamente, ver
  // Agencia.executivoId (resolvido a partir daqui pelo ExecutivoResolver).
  // Lista (não campo único) porque sócios que dividem o mesmo SICA (ex.:
  // sica 26) têm dois links pessoais diferentes apontando pra essa mesma
  // linha. Vazia pra quem não tem link (acima).
  linkExecutivoId String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agenciasAtribuidas Agencia[]
  bases              PromotorBase[]

  // Login desse Executivo na plataforma (Cargo.EXECUTIVO) — opcional,
  // concedido na criação/edição via /promotores (checkbox "Criar acesso na
  // plataforma"). Null = Promotor só de negócio, sem login.
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  @@index([gestorId])
  @@map("promotores")
}

// Entidade real do Gestor (2026-08-03) — antes só existia como texto livre
// em Promotor.gestor. Um Gestor pode ter vários Executivos (Promotor.gestorId)
// e várias Bases (GestorBase, mesmo padrão de PromotorBase).
model Gestor {
  id       String  @id @default(cuid())
  nome     String
  // Nullable+unique — Gestores criados pelo backfill a partir da string
  // legada (ver prisma/scripts/backfill-gestores.ts) não têm e-mail
  // conhecido até alguém preencher; Postgres permite múltiplos NULL num
  // campo @unique.
  email    String? @unique
  telefone String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bases      GestorBase[]
  promotores Promotor[]

  // Login desse Gestor na plataforma (Cargo.GESTOR) — opcional, mesmo
  // padrão de Promotor.userId acima.
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  @@map("gestores")
}

// Bases atendidas por um Gestor. `baseSigla` (legado) sendo substituída por
// `baseId`/`base`, FK real pro model `Base` (2026-08-04, ver
// prisma/scripts/importar-bases.ts) — mantida só durante a transição
// expand/contract, removida assim que o backfill terminar.
model GestorBase {
  id        String   @id @default(cuid())
  gestorId  String
  gestor    Gestor   @relation(fields: [gestorId], references: [id], onDelete: Cascade)
  baseId    String
  base      Base     @relation(fields: [baseId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([gestorId, baseId])
  @@map("gestor_bases")
}

// Bases atendidas por um gerente/promotor — fonte real: export
// "gerentes_conta_bases" (sistema anterior), 2026-07-27. Muitos-para-muitos
// porque um gerente pode atender várias bases (ex.: Douglas Mendes atende
// 16) e uma base pode ter mais de um gerente (ex.: RAO tem Douglas e
// Marcel). baseSigla usa o mesmo código de CidadeComercial.base, mas sem
// FK formal pra lá — fontes de dados diferentes, sem garantia de cobertura
// total (só 11 dos ~85 promotores aparecem nesse export).
model PromotorBase {
  id         String   @id @default(cuid())
  promotorId String
  promotor   Promotor @relation(fields: [promotorId], references: [id], onDelete: Cascade)
  baseId     String
  base       Base     @relation(fields: [baseId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([promotorId, baseId])
  @@map("promotor_bases")
}

// Base comercial real (2026-08-04, ver prisma/scripts/importar-bases.ts) —
// antes só existia como sigla livre em GestorBase/PromotorBase.baseSigla.
// Hierarquia Base -> Gestor -> Executivo: um Gestor atende várias Bases
// (GestorBase), um Executivo atende um subconjunto das bases do seu Gestor
// (PromotorBase, controlado só no frontend, sem enforcement aqui).
model Base {
  id             String  @id @default(cuid())
  sigla          String  @unique
  nomeCidade     String
  uf             String
  // regiao_id do export antigo — guardado solto, sem model Regiao formal
  // por ora (decisão do usuário, 2026-08-04). Não lido em nenhuma query hoje.
  regiaoIdLegado String?

  createdAt DateTime @default(now())

  gestorBases   GestorBase[]
  promotorBases PromotorBase[]

  @@map("bases")
}

// Hierarquia comercial (Agência → Executivo → Gestor, por Base/Região) —
// fonte real da planilha "MAPA COMERCIAL GESTORES" (aba MAPA_COMERCIAL_
// FINAL), antes carregada como mock em memória (ver git history do módulo
// atribuições). `executivo`/`gestor` aqui são os apelidos/nomes abreviados
// da planilha original, que não batem por string com `Promotor.nome`
// (nome completo) — cruzamento por nome, quando feito, é best-effort.
model CidadeComercial {
  id          String  @id @default(cuid())
  regiao      String?
  estado      String?
  cidade      String
  ddd         String?
  base        String?
  executivo   String?
  gestor      String?
  subregiaoSp String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([base])
  @@index([executivo])
  @@index([gestor])
  @@index([regiao])
  @@map("cidades_comerciais")
}

// Log de reatribuições feitas na tela Remanejar → Substituir do módulo
// atribuições (fundir/renomear um executivo, gestor ou base em todas as
// cidades atendidas por ele) — antes vivia só em memória, perdido a cada
// restart.
model SubstituicaoAtribuicao {
  id                   String @id @default(cuid())
  tipo                 String // "executivo" | "gestor" | "base"
  nomeAntigo           String
  nomeNovo             String
  totalCidadesAfetadas Int

  createdAt DateTime @default(now())

  @@map("substituicoes_atribuicoes")
}

// Grupo que recebe um percentual por indicar agências (decisão do
// usuário, 2026-07-24) — uma associação tem várias agências, mas cada
// agência pertence a no máximo uma (1:N, ver Agencia.associacaoId).
// `id` não é gerado aqui de propósito: preserva o uuid real do export
// (`associacoes-export-2026-07-24_18-58-37.csv`) em vez de cunhar um
// novo, pra bater com a fonte original se ela um dia virar integração
// de verdade.
model Associacao {
  // Sem default até 2026-08-04: só existiam registros de import, preservando
  // o uuid real do export (nunca criados pelo app). Ganha @default(cuid())
  // agora que a tela /associacoes passa a criar registros novos — não afeta
  // as linhas existentes, só as futuras sem id explícito.
  id        String   @id @default(cuid())
  nome      String
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agencias Agencia[]

  @@map("associacoes")
}

// Campanha de captação criada no painel (/painel/eventos) — o link
// personalizado (executivo e/ou associação) é montado na hora, client-side,
// a partir do slug do evento + ids já existentes de Promotor/Associacao;
// não tem tabela própria pra essa combinação (2026-07-25, decisão do
// usuário: nada de relevante se perde não persistindo, já que os ids em si
// já são gerenciados em outro lugar). Substitui o mock front-end que
// existia antes (sem tabela própria, link apontando pra uma rota `/{slug}`
// que nunca existiu de verdade) — agora o slug existe de verdade.
model Evento {
  id    String  @id @default(cuid())
  nome  String
  // Usado no link público em vez do id bruto (`/cadastro?evento=<slug>`) —
  // nullable pra não travar a criação do evento (o admin pode definir
  // depois); sem slug, o evento não tem link público funcional.
  slug  String? @unique
  ativo Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agencias Agencia[]

  @@map("eventos")
}
